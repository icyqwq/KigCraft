# KigCraft V2 - copy to .env and edit. Never commit .env.
APP_ENV=development

# Published ports (loopback only by default; put a TLS reverse proxy in front for public use).
API_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1

# Required. Use long random values.
POSTGRES_PASSWORD=change-me-postgres-password
JWT_SECRET=change-me-generate-a-long-random-secret

# Codex login used by the worker (a directory that contains an authenticated Codex auth.json). See README.
CODEX_CONFIG_DIR=./runtime/codex-home
# Must equal the Codex CLI version baked into the API image (docker-compose.yml passes it to both).
CODEX_VERSION=0.159.0-alpha.12.1

# Accounts and email. "console" prints verification codes to the API log; use tencent_ses for real email.
EMAIL_PROVIDER=console
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM_EMAIL=KigCraft <noreply@example.com>
TENCENT_SES_TEMPLATE_ID=
TENCENT_SES_LOGO_URL=

# Set to true behind HTTPS.
SESSION_COOKIE_SECURE=false
# Cloudflare Turnstile. Disabled for a private install; enable it and set your own keys for a public site.
CAPTCHA_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma separated reverse-proxy addresses whose X-Forwarded-For is trusted (the frontend container proxies /api).
TRUSTED_PROXY_HOSTS=*
CORS_ALLOWED_ORIGINS=

# Per-account limits.
V2_DESIGN_LIMIT_PER_USER=10
V2_SUBMIT_RATE_LIMIT_WINDOW_SECONDS=60
V2_SUBMIT_RATE_LIMIT_MAX_REQUESTS=6
